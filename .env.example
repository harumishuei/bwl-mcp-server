# Blueworks Live MCP Server - 環境変数設定例
# このファイルを .env にコピーして値を設定する

# ─── 必須 ──────────────────────────────────────────────
# Blueworks Live のアカウント名
BWL_ACCOUNT=your_account_name

# ─── 認証 (どちらか一方を設定) ──────────────────────────

# 方法1: OAuth2 Service ID（推奨・自動化向け）
# Admin > Account Information > Service IDs で発行
BWL_CLIENT_ID=your_client_id
BWL_CLIENT_SECRET=your_client_secret

# 方法2: Basic 認証（テスト用）
# BWL_USERNAME=your_email@example.com
# BWL_PASSWORD=your_password

# ─── オプション ─────────────────────────────────────────
# デフォルト: https://www.blueworkslive.com
# BWL_BASE_URL=https://www.blueworkslive.com
